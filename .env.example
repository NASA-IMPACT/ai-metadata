# Copy to .env and fill in what you have.
#
# Experiment 1 (token economy) needs NO credentials at all.
# Experiment 2 needs a working OpenAI key for the cloud arm and the DeepEval
# judge, plus a running Ollama for the open-weights arm.

# --- Cloud arm + DeepEval judge -------------------------------------------
OPENAI_API_KEY=

# --- Open-weights arm ------------------------------------------------------
# Pull the model first:  ollama pull qwen3.6
OLLAMA_HOST=http://localhost:11434

# --- Model matrix (optional overrides; comma-separated) --------------------
# Defaults: gpt-5,gpt-5-mini for OpenAI and qwen3.6:latest for Ollama.
# Names are validated against each provider's live model list at startup, so a
# retired name fails immediately instead of 404-ing mid-matrix.
# AIRM_OPENAI_MODELS=gpt-5,gpt-5-mini
# AIRM_OLLAMA_MODELS=qwen3.6:latest,gpt-oss:20b

# --- DeepEval judge (optional) ---------------------------------------------
# Held fixed across every cell and deliberately NOT drawn from the model matrix:
# a judge that varies with the model under test confounds the model axis.
# Point it at Ollama to exercise the pipeline without a cloud key.
# AIRM_JUDGE_PROVIDER=openai
# AIRM_JUDGE_MODEL=gpt-5-mini
