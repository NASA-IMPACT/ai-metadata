# Copy to .env and fill in the providers you want. The harness skips any tier
# whose credentials are absent (airm.llm.available_models), so you can run with
# just Ollama, or Ollama + Claude, etc.

# Cloud LLM tiers (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local Ollama (optional; default shown). Pull models with: ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434
