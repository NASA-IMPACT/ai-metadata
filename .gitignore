# airm: generated data artifacts — rebuilt deterministically (seeded) via
# `airm.queries --build`, `airm.corpus --build`, `airm.synth`.
# data/prices.json is user-authored config and stays trackable.
data/corpus.jsonl
data/corpus_report.json
data/gt.jsonl
data/gt_dropped.json
data/queries.jsonl
data/synthetic_report.json

# experiment run outputs (timestamped)
experiments/*/results/
/runs/
logs/

# Excel lock files
~$*.xlsx

# LLM-summary caches + summary-appended renderings (regenerable via
# scripts/summary_retrieval.py generate + scripts/summary_append_eval.py cache;
# new chroma dbs live under data/chroma/, already ignored above)
data/format_cache_summary/
data/format_cache_unfaceted_summary/
data/format_cache_plus_summary/
data/format_cache_unfaceted_plus_summary/
# Summary-replaces-abstract renderings (scripts/summary_replace_eval.py cache)
data/format_cache_replace_summary/
data/format_cache_unfaceted_replace_summary/
# Abstract-removed renderings (scripts/abstract_drop_eval.py cache)
data/format_cache_no_summary/
data/format_cache_unfaceted_no_abstract/
